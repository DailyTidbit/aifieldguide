{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Scan for Hydration Issues",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".\\detect-hydration.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": {
        "owner": "hydration-scanner",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^(.*):(\\d+):\\s*(.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Scan Hydration + Open in VS Code",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".\\detect-hydration.ps1",
        "-OpenInVSCode"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Quick Fix: Add Mounted State Pattern",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "Write-Host 'Copy this pattern to your component:'; Write-Host 'const [mounted, setMounted] = useState(false); useEffect(() => { setMounted(true) }, []); if (!mounted) { return <div>Loading...</div> }' -ForegroundColor Green"
      ],
      "group": "build"
    },
    {
      "label": "Test Hydration (Build)",
      "type": "npm",
      "script": "build",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": ["$tsc"]
    }
  ]
}